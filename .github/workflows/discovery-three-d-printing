name: Keepa Discovery 3D Printing

on:
  schedule:
    # 6:07 AM Eastern Daylight Time
    - cron: "7 10 * * *"
  workflow_dispatch:

permissions:
  contents: write

concurrency:
  group: keepa-discovery-sync
  cancel-in-progress: false

jobs:
  discover:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout repo
        uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - name: Setup Node
        uses: actions/setup-node@v4
        with:
          node-version: 24

      - name: Run 3D printing discovery
        env:
          KEEPA_API_KEY: ${{ secrets.KEEPA_API_KEY }}
        run: node scripts/keepa-discovery.js three_d_printing

      - name: Commit discovery results
        run: |
          git config user.name "keepa-bot"
          git config user.email "keepa-bot@users.noreply.github.com"

          git add data/discovered-asins.json

          git diff --cached --quiet || git commit -m "update 3d printing discovery pool"

          git pull --rebase origin main
          git push
